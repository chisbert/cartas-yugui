{
  "appId": "com.yugioh.deckmaster",
  "appName": "Yu-Gi-Oh! Deck & Card Master EU",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "backgroundColor": "#0B0F17",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0B0F17",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
